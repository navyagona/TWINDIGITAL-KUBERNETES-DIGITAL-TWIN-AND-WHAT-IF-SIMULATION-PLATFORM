# ============================================================
# TwinDigital — Environment Variables Template
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
POSTGRES_DB=twindigital
POSTGRES_USER=twindigital
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── JWT & Authentication ────────────────────────────────────
JWT_SECRET=CHANGE_ME_generate_a_unique_64_character_secret
JWT_EXPIRATION_MS=3600000
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password_here
BOOTSTRAP_ADMIN_EMAIL=admin@twindigital.local

# ── AWS ─────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
EKS_CLUSTER_NAME=twindigital-cluster

# ── Cluster Sync ────────────────────────────────────────────
# Base64-encoded kubeconfig for local dev only.
# In EKS, use IRSA — leave this blank.
KUBECONFIG_BASE64=

# Seconds between full cluster topology syncs
SYNC_INTERVAL_SECONDS=30

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
# Requests per window: anonymous callers by IP, authenticated callers by user
RATE_LIMIT_MAX_IP=60
RATE_LIMIT_MAX_USER=120

# ── Cost & Risk ───────────────────────────────────────────────
# Optional. Leave blank to get clearly labelled SAMPLE right-sizing data.
# e.g. http://host.docker.internal:9090
PROMETHEUS_URL=

# ── Terraform Remote State ───────────────────────────────────
TF_STATE_BUCKET=twindigital-tfstate-CHANGE_ME
TF_STATE_REGION=ap-south-1
TF_STATE_DYNAMO_TABLE=twindigital-tflock
